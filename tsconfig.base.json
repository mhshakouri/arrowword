{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Node 24 runs the unit tests with native type stripping, which needs the
    // explicit .ts extension on relative imports.
    "allowImportingTsExtensions": true
  }
}
