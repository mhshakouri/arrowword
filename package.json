{
  "name": "arrowword",
  "version": "0.1.0",
  "private": true,
  "description": "Cooperative Persian arrowword solving for two devices, from a photo, without OCR.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:ui": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.ui.json",
    "test": "npm run test:unit && node test/acceptance.mjs && node test/photo-limit.mjs && node test/expiry.mjs",
    "test:acceptance": "node test/acceptance.mjs",
    "test:expiry": "node test/expiry.mjs",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test src/*.test.ts src/generate/*.test.ts src/ui/lib/*.test.ts",
    "test:photo": "node test/photo-limit.mjs",
    "test:template": "node test/template.mjs",
    "test:all": "npm test && npm run test:template"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.117.0"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
