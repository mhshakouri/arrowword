{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arrowword",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ARROWWORD_SESSION", "class_name": "ArrowwordSession" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    // SQLite-backed Durable Objects, required for the storage API used here.
    { "tag": "v1", "new_sqlite_classes": ["ArrowwordSession"] },
    // Adding a class is the safe direction of a DO migration. Renaming or
    // deleting one is not: see spec section 16 under Rollback.
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
  ],
  // The Vite build output, served by this same worker so the UI and the API are
  // same-origin and CORS is unnecessary (ADR-10, spec section 2).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client routes like /new and /s/:id are not files on disk, so an unmatched
    // path returns index.html and the app routes it.
    "not_found_handling": "single-page-application",
    // Explicit rather than relying on precedence: these prefixes must reach the
    // worker even though the SPA fallback would otherwise answer them. Getting
    // this wrong would serve index.html for API calls.
    // `/session` and `/session/*` are both listed on purpose: the wildcard
    // needs a trailing segment, so listing only `/session/*` sent `POST
    // /session` to the asset worker, which answers GET and returned 405.
    "run_worker_first": [
      "/session",
      "/session/*",
      "/config",
      "/generate",
      "/auth",
      "/auth/*",
    ],
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "arrowword-photos",
      // Create before the first deploy:
      //   npx wrangler r2 bucket create arrowword-photos
    },
  ],
  // Uncomment once the DNS record exists, then deploy to attach the subdomain.
  // "routes": [
  //   { "pattern": "arrowword.mhshakouri.dev", "custom_domain": true },
  // ],
  "vars": {
    // Session ids that are demo templates: never expire, never writable, meant
    // to be cloned. Configuration rather than data so nothing can mint one by
    // request. Set this to the puzzle id after tagging it, then deploy.
    "TEMPLATE_SESSIONS": "a8dae3c161debc4e8ed0336f3938b797",
    // Same-origin once the UI is served from this worker, so this stays empty
    // unless a different origin ever needs access.
    "ALLOWED_ORIGINS": "",
  },
}
