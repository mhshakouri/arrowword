{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arrowword",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ARROWWORD_SESSION", "class_name": "ArrowwordSession" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  // Workers AI, B3. No key, no account setup, no spend cap: the free
  // allocation fails with errors rather than charging, which is what ADR-12
  // rests on and section 16 records having checked.
  "ai": { "binding": "AI" },
  "migrations": [
    // SQLite-backed Durable Objects, required for the storage API used here.
    { "tag": "v1", "new_sqlite_classes": ["ArrowwordSession"] },
    // Adding a class is the safe direction of a DO migration. Renaming or
    // deleting one is not: see spec section 16 under Rollback.
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
  ],
  // The Vite build output, served by this same worker so the UI and the API are
  // same-origin and CORS is unnecessary (ADR-10, spec section 2).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client routes like /new and /s/:id are not files on disk, so an unmatched
    // path returns index.html and the app routes it.
    "not_found_handling": "single-page-application",
    // Explicit rather than relying on precedence: these prefixes must reach the
    // worker even though the SPA fallback would otherwise answer them. Getting
    // this wrong would serve index.html for API calls.
    // `/session` and `/session/*` are both listed on purpose: the wildcard
    // needs a trailing segment, so listing only `/session/*` sent `POST
    // /session` to the asset worker, which answers GET and returned 405.
    "run_worker_first": [
      "/session",
      "/session/*",
      "/config",
      // Every method, including the browser asking for the page: the worker
      // serves the shell for a GET rather than letting the asset handler have
      // the path, because POST must reach the worker and this list is not
      // method-aware.
      "/generate",
      // Removed 2026-08-04: "/auth" and "/auth/*" were here for the sign-in
      // that ADR-12 deleted, and had been routing to a worker that answers 404.
    ],
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "arrowword-photos",
      // Create before the first deploy:
      //   npx wrangler r2 bucket create arrowword-photos
    },
  ],
  // Uncomment once the DNS record exists, then deploy to attach the subdomain.
  // "routes": [
  //   { "pattern": "arrowword.mhshakouri.dev", "custom_domain": true },
  // ],
  "vars": {
    // Session ids that are demo templates: never expire, never writable, meant
    // to be cloned. Configuration rather than data so nothing can mint one by
    // request. Set this to the puzzle id after tagging it, then deploy.
    "TEMPLATE_SESSIONS": "c39452c354bb9df1b59990ee899d1c81",
    // Per-IP hourly ceilings. Empty means the defaults in src/index.ts, which
    // spec section 7 documents. Set one here to tune without a code change.
    "RATE_LIMIT_SESSION": "",
    "RATE_LIMIT_PHOTO": "",
    "RATE_LIMIT_CLONE": "",
    // Same-origin once the UI is served from this worker, so this stays empty
    // unless a different origin ever needs access.
    "ALLOWED_ORIGINS": "",
    // Turnstile, B3. Public by design: it ships in the client bundle, which is
    // why it belongs here and not in a secret. Its partner, TURNSTILE_SECRET,
    // is set with `wrangler secret put` and must never appear in this file.
    // Verified 2026-08-03 by rendering the widget against localhost; the
    // hostname list on the widget must include both localhost and the
    // production subdomain or the challenge fails with a domain error.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEFf0D8w4Nnv-fZm",
    // Which Workers AI model writes the puzzle. Empty uses the default in
    // src/generate/provider.ts. Set here so comparing two models is a config
    // change and a deploy rather than a code edit. The daily ceiling in spec
    // section 7 is derived from the chosen model's output rate, so switching to
    // one with a different rate means re-deriving it.
    "GENERATION_MODEL": "",
    // "1" logs the model's raw output, truncated to 400 characters.
    // **Diagnosis only, and it should go back to "" once a question is
    // answered.** Spec section 16 forbids logging puzzle content, and this is
    // the one switch that does. On now because the model could not produce a
    // valid layout and nobody has seen what it actually replies with.
    "GENERATION_DEBUG": "1",
  },
}
