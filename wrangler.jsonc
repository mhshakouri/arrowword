{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arrowword",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ARROWWORD_SESSION", "class_name": "ArrowwordSession" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    // SQLite-backed Durable Objects, required for the storage API used here.
    { "tag": "v1", "new_sqlite_classes": ["ArrowwordSession"] },
    // Adding a class is the safe direction of a DO migration. Renaming or
    // deleting one is not: see spec section 16 under Rollback.
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "arrowword-photos",
      // Create before the first deploy:
      //   npx wrangler r2 bucket create arrowword-photos
    },
  ],
  // Uncomment once the DNS record exists, then deploy to attach the subdomain.
  // "routes": [
  //   { "pattern": "arrowword.mhshakouri.dev", "custom_domain": true },
  // ],
  "vars": {
    // Same-origin once the UI is served from this worker, so this stays empty
    // unless a different origin ever needs access.
    "ALLOWED_ORIGINS": "",
  },
}
