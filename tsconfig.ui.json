{
  // The UI has no Workers types, for the mirror-image reason: a Durable Object
  // binding is not reachable from the browser.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" is here for the unit tests, which run on node:test.
    "types": ["node"]
  },
  "include": ["src/ui/**/*.ts", "src/types.ts", "vite.config.ts"]
}
